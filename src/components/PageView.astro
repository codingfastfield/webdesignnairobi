---
import Base from '../layouts/Base.astro';
import HeroMedia from './HeroMedia.astro';
import Showcase from './Showcase.astro';
import { site, quoteLink, kes } from '../data/site';
import { themes } from '../data/theme';
import { clusters, bySlug, url, related, anchor, cap, children, type Page } from '../data/pages';
import { build } from '../data/content';
import { blobMorph } from '../data/blob';
interface Props { page: Page }
const { page } = Astro.props;
const c = build(page);
const rel = related(page);
const cl = clusters[page.cluster];
const hub = bySlug[cl.hub];
const pricing = bySlug['website-design-prices-nairobi'];
const path = url(page);
const th = themes[page.cluster];
const crumbs = [
  { name: 'Home', path: '/' },
  ...(page.home ? [] : page.hub ? [] : [{ name: cap(hub.kw), path: url(hub) }]),
  ...(page.home ? [] : [{ name: cap(page.kw), path }]),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': ['ProfessionalService', 'LocalBusiness'], '@id': `${site.url}/#org`, name: site.name, alternateName: 'WebDesignNairobi', url: site.url,
      logo: { '@type': 'ImageObject', url: `${site.url}/icon-512.png`, width: 512, height: 512 },
      image: [`${site.url}/og-image.jpg`],
      areaServed: [{ '@type': 'City', name: 'Nairobi' }, { '@type': 'Country', name: 'Kenya' }],
      address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
      priceRange: 'KES 9,999 - KES 79,999', ...(site.phone ? { telephone: site.phone } : {}), ...(site.email ? { email: site.email } : {}) },
    { '@type': 'Service', name: cap(page.kw), serviceType: 'Website design and development', provider: { '@id': `${site.url}/#org` }, areaServed: 'Nairobi, Kenya' },
    { '@type': 'FAQPage', mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name, item: new URL(x.path, site.url).href })) },
  ],
};
const orbMorph = blobMorph(60, 60, [[44, 50, 42, 52, 46, 40, 50, 44], [52, 42, 50, 44, 40, 52, 44, 50], [42, 48, 52, 42, 50, 44, 48, 52]]);
const listCluster = !page.home && page.hub ? page.cluster : null;
const homeClusters = page.home ? (Object.keys(clusters) as (keyof typeof clusters)[]) : [];
const shopFrom = site.tiers.find((t) => t.name === 'Ecommerce')?.from ?? 0;
const ticker = ['Website design', 'Development', 'SEO', 'Ecommerce', 'M-Pesa', 'Hosting', 'Mobile-first', 'Support'];
---
<Base title={c.title} description={c.description} path={path} jsonLd={jsonLd}>
  <div class="theme" style={`--a:${th.a};--b:${th.b}`}>
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <span class="shape s1" data-par="0.30"><i></i></span>
        <span class="shape s2" data-par="-0.22"><i></i></span>
        <span class="shape s3" data-par="0.14"><i></i></span>
        <span class="shape s4" data-par="-0.38"><i></i></span>
      </div>
      <div class="wrap hero-grid">
        <div class="hero-text">
          <nav class="crumbs" aria-label="Breadcrumb">
            {crumbs.map((x, i) => i < crumbs.length - 1 ? <><a href={x.path}>{x.name}</a><span>/</span></> : <span aria-current="page">{x.name}</span>)}
          </nav>
          <h1>{c.h1}</h1>
          <p class="lead">{c.lead}</p>
          <p class="cta">
            <a class="btn" href={quoteLink(page.kw)}>Get a fixed quote</a>
            <a class="btn ghost" href={url(pricing)}>See prices</a>
          </p>
          <ul class="trust"><li>Fixed written quote</li><li>M-Pesa ready</li><li>You own everything</li></ul>
        </div>
        <div class="hero-art"><HeroMedia ind={page.ind} cluster={page.cluster} /></div>
      </div>
    </section>
    <div class="ticker" aria-hidden="true">
      <div class="track">{[0, 1, 2, 3].map(() => ticker.map((t) => <span>{t}<i></i></span>))}</div>
    </div>

    <div class="wrap body">
      {c.sections.map((s, n) => (
        <section>
          <h2>{s.h2}</h2>
          {n === 0 ? (
            <>
              <span class="deco dc1" data-par="0.22" aria-hidden="true"><i></i></span>
              <ul class="bento">{s.items.map((i) => <li><b aria-hidden="true"></b>{i}</li>)}</ul>
            </>
          ) : (
            <ul class="ticks">{s.items.map((i) => <li>{i}</li>)}</ul>
          )}
        </section>
      ))}

      <section>
        <span class="deco dc2" data-par="-0.16" aria-hidden="true"><i></i></span>
        <h2>How we build it</h2>
        <ol class="timeline">{c.steps.map(([t, d], k) => <li><b>{k + 1}</b><h3>{t}</h3><p>{d}</p></li>)}</ol>
      </section>

      {page.home && (
        <Showcase variant="shop" src="/images/online-shop-mobile.webp" width={900} height={822} alt="Phone showing an online shop, with a shopping bag, bank card and gold coin">
          <h2>Online shops that take M-Pesa and cards</h2>
          <p>Product catalogue, cart and checkout built for phones, with order emails and delivery options. Shops start from {kes(shopFrom)}.</p>
          <p class="cta"><a class="btn" href={url(bySlug['ecommerce-website-design-nairobi'])}>See ecommerce websites</a></p>
        </Showcase>
      )}

      <section>
        <h2>Packages</h2>
        <div class="tiers">
          {site.tiers.map((t, k) => (
            <div class={`tier ${t.popular ? 'pop' : ''}`}>
              {t.popular && <span class="badge">Most chosen</span>}
              <h3>{t.name}</h3>
              <p class="price">{t.from ? <>From {kes(t.from)}</> : 'Fixed quote'}</p>
              <p class="muted">{t.scope}. {t.who}.</p>
              <ul>{t.includes.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
        <p>
          Budget is the first question most people ask, so start with <a href={url(pricing)}>{anchor(pricing, page)}</a>
          {rel.next && <> or move on to <a href={url(rel.next)}>{anchor(rel.next, page)}</a></>}.
          {rel.prev && <> Not sure yet? Go back to <a href={url(rel.prev)}>{anchor(rel.prev, page)}</a>.</>}
        </p>
      </section>

      <section class="wide">
        <h2>Service prices</h2>
        <ul class="plist">
          {site.services.map((v) => (
            <li>
              <div><b>{v.name}</b><span>{v.note}</span></div>
              <em><small>from</small>{kes(v.from)}{v.unit && <small>{v.unit}</small>}</em>
            </li>
          ))}
        </ul>
        <p class="muted">Prices are starting points in Kenya shillings. After a short brief you get a fixed written quote with the exact scope, price and timeline.</p>
      </section>

      {page.home && (
        <Showcase variant="shop" reverse src="/images/seo-laptop.webp" width={900} height={634} alt="Laptop showing a top Google search result, with a magnifying glass, growth chart and trophy">
          <h2>Found on Google, not just admired</h2>
          <p>Every page is built around the searches your customers actually make, with fast loading, a clean structure and Nairobi search in mind, so the right people can find you.</p>
          <p class="cta"><a class="btn" href={url(bySlug['website-design-services-nairobi'])}>See our services</a></p>
        </Showcase>
      )}

      {(listCluster || page.home) && (
        <section class="wide">
          <h2>{page.home ? 'Everything we cover' : `More in ${cl.label.toLowerCase()}`}</h2>
          <div class="cards">
            {(page.home ? homeClusters : [page.cluster]).map((id) => (
              <div class="group" style={`--a:${themes[id].a};--b:${themes[id].b}`}>
                {page.home && <h3><a href={url(bySlug[clusters[id].hub])}>{clusters[id].label}</a></h3>}
                <ul class="links">{children(id).map((x) => <li><a href={url(x)}>{anchor(x, page)}</a></li>)}</ul>
              </div>
            ))}
          </div>
        </section>
      )}

      {page.home && (
        <Showcase variant="photo" portrait src="/images/business-owner-tablet.webp" width={900} height={945} alt="Smiling cafe owner in a black apron showing her new website on a tablet">
          <h2>Built for Nairobi businesses like yours</h2>
          <p>Cafes, restaurants, shops, clinics, schools and more. We build the site around how your customers decide, whether that is a menu, a booking or a quick call.</p>
          <p class="cta"><a class="btn" href={url(bySlug['business-website-design-nairobi'])}>Browse by industry</a></p>
        </Showcase>
      )}

      <section>
        <span class="deco dc3" data-par="0.2" aria-hidden="true"><i></i></span>
        <h2>Frequently asked questions</h2>
        {c.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>

      {(rel.hub || rel.siblings.length > 0 || rel.similar.length > 0) && (
        <section class="wide related">
          <h2>Related pages</h2>
          <ul class="chips">
            {rel.hub && <li><a href={url(rel.hub)}>{anchor(rel.hub, page)}</a></li>}
            {[...rel.siblings, ...rel.similar].map((x) => <li><a href={url(x)}>{anchor(x, page)}</a></li>)}
          </ul>
          {page.variants.length > 0 && <p class="muted">Also searched: {page.variants.join(', ')}.</p>}
        </section>
      )}

      <section class="wide final">
        <div>
          <h2>Ready for a quote?</h2>
          <p>Tell us what you need. You get a fixed written quote with scope, price and timeline.</p>
          <p class="cta"><a class="btn light" href={quoteLink(page.kw)}>Get a fixed quote</a><a class="btn ghost-w" href={`tel:${site.phone}`}>Call {site.phone}</a></p>
        </div>
        <span class="fb fb1" data-par="0.12" aria-hidden="true"></span>
        <span class="fb fb2" data-par="-0.12" aria-hidden="true"></span>
        <svg viewBox="0 0 120 120" aria-hidden="true" class="orb">
          <path d={orbMorph.d} fill="#fff" fill-opacity=".22">
            <animate attributeName="d" dur="9s" repeatCount="indefinite" calcMode="spline" keyTimes={orbMorph.keyTimes} keySplines={orbMorph.keySplines} values={orbMorph.values} />
          </path>
          <circle cx="60" cy="60" r="56" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width="2" stroke-dasharray="4 8" class="spin" />
          <circle cx="60" cy="60" r="14" fill="#fff" />
        </svg>
      </section>
    </div>
  </div>
</Base>
