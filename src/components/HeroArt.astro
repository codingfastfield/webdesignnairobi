---
// Programmatic illustration: a browser + phone composition, themed per cluster, with an icon per industry.
interface Props { ind?: string }
const { ind } = Astro.props;
const glyphs: Record<string, string> = {
  company: 'M4 21V6l8-3 8 3v15M9 21v-4h6v4M8 9h2M14 9h2M8 13h2M14 13h2',
  ecommerce: 'M6 8h12l-1 12H7L6 8zM9 8a3 3 0 016 0',
  restaurant: 'M7 3v8a2 2 0 004 0V3M9 11v10M17 3c-2 2-2 6 0 8v10',
  hotel: 'M3 19V6M3 14h18v5M21 14v-3a3 3 0 00-3-3h-7v6',
  realestate: 'M3 11l9-7 9 7M5 10v10h14V10M10 20v-6h4v6',
  school: 'M2 9l10-5 10 5-10 5-10-5zM6 11v5c3 2 9 2 12 0v-5',
  hospital: 'M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z',
  lawfirm: 'M12 3v18M5 21h14M5 7h14M5 7l-3 7a3 3 0 006 0L5 7zM19 7l-3 7a3 3 0 006 0l-3-7z',
  construction: 'M4 16a8 8 0 0116 0M2 16h20v3H2zM12 8v8',
  ngo: 'M12 21s-8-5.5-8-11a4.5 4.5 0 018-2.5A4.5 4.5 0 0120 10c0 5.5-8 11-8 11z',
  church: 'M12 2v5M10 4.5h4M6 22V12l6-4 6 4v10M10 22v-5h4v5',
  portfolio: 'M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6',
  personal: 'M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0',
};
const glyph = glyphs[ind ?? ''] ?? 'M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14';
---
<svg class="art" viewBox="0 0 520 440" role="img" aria-label="Illustration of a website on desktop and mobile" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--a)" /><stop offset="1" stop-color="var(--b)" /></linearGradient>
    <linearGradient id="g2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--b)" /><stop offset="1" stop-color="var(--a)" /></linearGradient>
    <filter id="sh" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#2b1d6b" flood-opacity=".18" /></filter>
    <pattern id="dots" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" fill="var(--a)" opacity=".35" /></pattern>
  </defs>
  <circle cx="300" cy="215" r="185" fill="var(--b)" opacity=".18" class="pulse" />
  <circle cx="190" cy="250" r="140" fill="var(--a)" opacity=".10" class="pulse p2" />
  <rect x="6" y="20" width="110" height="80" fill="url(#dots)" />
  <path d="M410 40q14-18 28 0t28 0t28 0" fill="none" stroke="var(--a)" stroke-width="5" stroke-linecap="round" class="f2" />

  <g class="f1" filter="url(#sh)">
    <rect x="30" y="64" width="350" height="268" rx="20" fill="#fff" stroke="#E8E4F7" />
    <path d="M30 84a20 20 0 0120-20h310a20 20 0 0120 20v20H30z" fill="#F3F0FF" />
    <circle cx="54" cy="84" r="5.5" fill="#FF5F57" /><circle cx="72" cy="84" r="5.5" fill="#FEBC2E" /><circle cx="90" cy="84" r="5.5" fill="#28C840" />
    <rect x="112" y="75" width="190" height="18" rx="9" fill="#fff" stroke="#E8E4F7" />
    <text x="124" y="88" font-size="9.5" fill="#6B6788" font-family="ui-monospace,Menlo,monospace">webdesignnairobi.co.ke</text>
    <rect x="50" y="118" width="310" height="104" rx="14" fill="url(#g1)" />
    <rect x="68" y="138" width="150" height="13" rx="6.5" fill="#fff" />
    <rect x="68" y="160" width="108" height="8" rx="4" fill="#fff" opacity=".7" />
    <rect x="68" y="180" width="76" height="24" rx="12" fill="#fff" />
    <rect x="80" y="189" width="52" height="6" rx="3" fill="var(--a)" />
    <rect x="266" y="134" width="76" height="76" rx="20" fill="#fff" opacity=".22" />
    <g transform="translate(278 146) scale(2)" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={glyph} /></g>
    {[0, 1, 2].map((i) => (
      <g transform={`translate(${50 + i * 106} 238)`}>
        <rect width="96" height="74" rx="12" fill="#FAF9FF" stroke="#ECE8FA" />
        <circle cx="22" cy="22" r="10" fill={i === 1 ? 'var(--b)' : 'var(--a)'} opacity=".9" />
        <rect x="12" y="42" width="60" height="7" rx="3.5" fill="#D9D3F2" />
        <rect x="12" y="55" width="40" height="7" rx="3.5" fill="#E9E5F8" />
      </g>
    ))}
  </g>

  <g class="f3" filter="url(#sh)">
    <g transform="rotate(6 390 235)">
      <rect x="332" y="118" width="126" height="236" rx="24" fill="#fff" stroke="#E8E4F7" />
      <rect x="378" y="127" width="34" height="8" rx="4" fill="#E8E4F7" />
      <rect x="344" y="146" width="102" height="62" rx="12" fill="url(#g2)" />
      <rect x="354" y="158" width="58" height="9" rx="4.5" fill="#fff" />
      <rect x="354" y="174" width="40" height="6" rx="3" fill="#fff" opacity=".7" />
      <rect x="344" y="218" width="48" height="58" rx="10" fill="#FAF9FF" stroke="#ECE8FA" />
      <rect x="398" y="218" width="48" height="58" rx="10" fill="#FAF9FF" stroke="#ECE8FA" />
      <circle cx="368" cy="238" r="9" fill="var(--b)" /><circle cx="422" cy="238" r="9" fill="var(--a)" />
      <rect x="344" y="292" width="102" height="30" rx="15" fill="var(--a)" />
      <rect x="371" y="304" width="48" height="6" rx="3" fill="#fff" />
    </g>
  </g>

  <g class="f2">
    <g filter="url(#sh)"><rect x="10" y="338" width="132" height="40" rx="20" fill="#fff" /></g>
    <circle cx="32" cy="358" r="12" fill="#12B76A" /><path d="M27 361l5-6 5 6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    <text x="52" y="362" font-size="12" font-weight="700" fill="#2b2650" font-family="DM Sans,system-ui,sans-serif">Page 1 on Google</text>
  </g>
  <g class="f1 d2">
    <g filter="url(#sh)"><rect x="350" y="368" width="116" height="38" rx="19" fill="#12B76A" /></g>
    <circle cx="372" cy="387" r="9" fill="#fff" /><path d="M368 387l3 3 5-6" fill="none" stroke="#12B76A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    <text x="388" y="391" font-size="12" font-weight="700" fill="#fff" font-family="DM Sans,system-ui,sans-serif">M-Pesa ready</text>
  </g>
  <g class="spin" fill="none" stroke="var(--b)" stroke-width="4" stroke-linecap="round"><path d="M468 120v22M457 131h22" /></g>
  <circle cx="22" cy="190" r="9" fill="none" stroke="var(--a)" stroke-width="4" class="f3" />
  <path d="M176 196l4 36 9-10 12 22 8-5-12-22 13-3z" fill="#2b2650" stroke="#fff" stroke-width="2" stroke-linejoin="round" class="f2 d2" />
</svg>
