---
// Programmatic illustration: a browser + phone composition, themed per cluster, with an icon per industry.
import { blobMorph } from '../data/blob';
interface Props { ind?: string }
const { ind } = Astro.props;
const glyphs: Record<string, string> = {
  company: 'M4 21V6l8-3 8 3v15M9 21v-4h6v4M8 9h2M14 9h2M8 13h2M14 13h2',
  ecommerce: 'M6 8h12l-1 12H7L6 8zM9 8a3 3 0 016 0',
  restaurant: 'M7 3v8a2 2 0 004 0V3M9 11v10M17 3c-2 2-2 6 0 8v10',
  hotel: 'M3 19V6M3 14h18v5M21 14v-3a3 3 0 00-3-3h-7v6',
  realestate: 'M3 11l9-7 9 7M5 10v10h14V10M10 20v-6h4v6',
  school: 'M2 9l10-5 10 5-10 5-10-5zM6 11v5c3 2 9 2 12 0v-5',
  hospital: 'M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z',
  lawfirm: 'M12 3v18M5 21h14M5 7h14M5 7l-3 7a3 3 0 006 0L5 7zM19 7l-3 7a3 3 0 006 0l-3-7z',
  construction: 'M4 16a8 8 0 0116 0M2 16h20v3H2zM12 8v8',
  ngo: 'M12 21s-8-5.5-8-11a4.5 4.5 0 018-2.5A4.5 4.5 0 0120 10c0 5.5-8 11-8 11z',
  church: 'M12 2v5M10 4.5h4M6 22V12l6-4 6 4v10M10 22v-5h4v5',
  portfolio: 'M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6',
  personal: 'M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0',
};
const glyph = glyphs[ind ?? ''] ?? 'M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14';

const big = blobMorph(268, 222, [
  [178, 200, 172, 196, 184, 168, 200, 176],
  [200, 172, 196, 170, 198, 190, 168, 194],
  [170, 190, 204, 180, 166, 198, 184, 206],
  [192, 176, 170, 202, 194, 172, 206, 182],
]);
const ringM = blobMorph(268, 222, [
  [206, 214, 200, 220, 208, 196, 222, 204],
  [220, 200, 214, 196, 222, 214, 196, 218],
  [198, 218, 224, 204, 194, 220, 208, 226],
]);
const dotColors = ['var(--a)', 'var(--b)', 'var(--d)'];
---
<svg class="art" viewBox="0 0 520 440" role="img" aria-label="Illustration of a website on desktop and mobile" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--a)" /><stop offset="1" stop-color="var(--b)" /></linearGradient>
    <linearGradient id="g2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#171717" /><stop offset="1" stop-color="#3A3322" /></linearGradient>
    <linearGradient id="gblob" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--a)" /><stop offset=".5" stop-color="var(--b)" /><stop offset="1" stop-color="var(--d)" />
      <animateTransform attributeName="gradientTransform" type="rotate" from="0 .5 .5" to="360 .5 .5" dur="22s" repeatCount="indefinite" />
    </linearGradient>
    <filter id="sh" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="18" stdDeviation="14" flood-color="#171717" flood-opacity=".2" /></filter>
    <pattern id="dots" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" fill="#fff" opacity=".35" /></pattern>
  </defs>

  <g data-depth="-8">
    <path d={big.d} fill="url(#gblob)" opacity=".95">
      <animate attributeName="d" dur="18s" repeatCount="indefinite" calcMode="spline" keyTimes={big.keyTimes} keySplines={big.keySplines} values={big.values} />
    </path>
    <path d={ringM.d} fill="none" stroke="var(--d)" stroke-width="2" stroke-dasharray="3 9" stroke-linecap="round" opacity=".8">
      <animate attributeName="d" dur="14s" repeatCount="indefinite" calcMode="spline" keyTimes={ringM.keyTimes} keySplines={ringM.keySplines} values={ringM.values} />
    </path>
  </g>

  <g data-depth="-16">
    <rect x="6" y="20" width="110" height="80" fill="url(#dots)" />
    <path d="M410 40q14-18 28 0t28 0t28 0" fill="none" stroke="var(--c)" stroke-width="5" stroke-linecap="round" class="f2" />
    <g class="spin" fill="none" stroke="var(--d)" stroke-width="4" stroke-linecap="round"><path d="M468 120v22M457 131h22" /></g>
    <circle cx="22" cy="190" r="9" fill="none" stroke="var(--c)" stroke-width="4" class="f3" />
  </g>

  <g data-depth="12"><g class="f1" filter="url(#sh)">
    <rect x="30" y="64" width="350" height="268" rx="20" fill="#fff" />
    <path d="M30 84a20 20 0 0120-20h310a20 20 0 0120 20v20H30z" fill="#ECE9E0" />
    <circle cx="54" cy="84" r="5.5" fill="#FF5F57" /><circle cx="72" cy="84" r="5.5" fill="#FEBC2E" /><circle cx="90" cy="84" r="5.5" fill="#28C840" />
    <rect x="112" y="75" width="190" height="18" rx="9" fill="#fff" stroke="#DDD8CA" />
    <text x="124" y="88" font-size="9.5" fill="#6B665A" font-family="ui-monospace,Menlo,monospace">webdesignnairobi.co.ke</text>
    <rect x="50" y="118" width="310" height="104" rx="14" fill="url(#g1)" />
    <rect x="68" y="138" width="150" height="13" rx="6.5" fill="#fff" />
    <rect x="68" y="160" width="108" height="8" rx="4" fill="#fff" opacity=".7" />
    <rect x="68" y="180" width="76" height="24" rx="12" fill="#fff" />
    <rect x="80" y="189" width="52" height="6" rx="3" fill="var(--a)" />
    <rect x="266" y="134" width="76" height="76" rx="20" fill="#fff" opacity=".22" />
    <g transform="translate(278 146) scale(2)" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={glyph} /></g>
    {[0, 1, 2].map((i) => (
      <g transform={`translate(${50 + i * 106} 238)`}>
        <rect width="96" height="74" rx="12" fill="#F7F6F2" stroke="#E3DFD2" />
        <circle cx="22" cy="22" r="10" fill={dotColors[i]} />
        <rect x="12" y="42" width="60" height="7" rx="3.5" fill="#D3CEBE" />
        <rect x="12" y="55" width="40" height="7" rx="3.5" fill="#E3DFD2" />
      </g>
    ))}
  </g></g>

  <g data-depth="26"><g class="f3" filter="url(#sh)">
    <g transform="rotate(6 390 235)">
      <rect x="332" y="118" width="126" height="236" rx="24" fill="#fff" />
      <rect x="378" y="127" width="34" height="8" rx="4" fill="#E3DFD2" />
      <rect x="344" y="146" width="102" height="62" rx="12" fill="url(#g2)" />
      <rect x="354" y="158" width="58" height="9" rx="4.5" fill="#fff" />
      <rect x="354" y="174" width="40" height="6" rx="3" fill="#fff" opacity=".7" />
      <rect x="344" y="218" width="48" height="58" rx="10" fill="#F7F6F2" stroke="#E3DFD2" />
      <rect x="398" y="218" width="48" height="58" rx="10" fill="#F7F6F2" stroke="#E3DFD2" />
      <circle cx="368" cy="238" r="9" fill="var(--b)" /><circle cx="422" cy="238" r="9" fill="var(--a)" />
      <rect x="344" y="292" width="102" height="30" rx="15" fill="var(--a)" />
      <rect x="371" y="304" width="48" height="6" rx="3" fill="#fff" />
    </g>
  </g></g>

  <g data-depth="42">
    <g class="f2">
      <g filter="url(#sh)"><rect x="10" y="338" width="150" height="42" rx="21" fill="#fff" /></g>
      <circle cx="33" cy="359" r="12" fill="#C9A227" /><path d="M28 362l5-6 5 6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      <text x="54" y="363" font-size="12.5" font-weight="700" fill="#171717" font-family="Instrument Sans,system-ui,sans-serif">Page 1 on Google</text>
    </g>
    <g class="f1 d2">
      <g filter="url(#sh)"><rect x="350" y="368" width="124" height="40" rx="20" fill="#171717" /></g>
      <circle cx="372" cy="388" r="9" fill="#fff" /><path d="M368 388l3 3 5-6" fill="none" stroke="#171717" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      <text x="388" y="392" font-size="12.5" font-weight="700" fill="#fff" font-family="Instrument Sans,system-ui,sans-serif">M-Pesa ready</text>
    </g>
    <g class="f3">
      <circle cx="476" cy="62" r="15" fill="var(--c)" filter="url(#sh)" />
      <path d="M476 53v18M467 62h18" stroke="#171717" stroke-width="2.6" stroke-linecap="round" />
    </g>
  </g>

  <g data-depth="54"><path d="M176 196l4 36 9-10 12 22 8-5-12-22 13-3z" fill="#fff" stroke="#171717" stroke-width="2" stroke-linejoin="round" class="f2 d2" /></g>
</svg>
