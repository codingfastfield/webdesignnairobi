---
// Image + copy band. `variant` picks the frame: "photo" = rounded cream card for cut-out photos,
// "shop" = soft gold blob behind a floating 3D render. `reverse` puts the image on the left.
interface Props { src: string; width: number; height: number; alt: string; variant?: 'photo' | 'shop'; reverse?: boolean; portrait?: boolean }
const { src, width, height, alt, variant = 'photo', reverse = false, portrait = false } = Astro.props;
const frame = variant === 'shop' ? 'shop-stage' : `photo-stage ${portrait ? 'portrait' : ''}`;
---
<section class={`wide showcase ${reverse ? 'rev' : ''}`}>
  <div class="show-copy"><slot /></div>
  <div class={frame}>
    <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  </div>
</section>
