---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, quoteLink } from '../data/site';
import { clusters, bySlug, url } from '../data/pages';
interface Props { title: string; description: string; path: string; jsonLd?: object }
const { title, description, path, jsonLd } = Astro.props;
const canonical = new URL(path, site.url).href;
const hubs = Object.values(clusters).map((c) => bySlug[c.hub]);
---
<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0C0420" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400..700&display=swap" rel="stylesheet" />
    <ClientRouter />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_KE" />
    <meta name="geo.region" content="KE-30" />
    <meta name="geo.placename" content="Nairobi" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="aurora" aria-hidden="true" transition:persist="aurora">
      <i class="o1" data-fix="0.10"></i><i class="o2" data-fix="-0.07"></i><i class="o3" data-fix="0.16"></i><i class="o4" data-fix="-0.14"></i>
    </div>
    <header class="top" data-top>
      <a class="logo" href="/"><span class="mark" aria-hidden="true"></span><span>webdesign<b>nairobi</b>.co.ke</span></a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav" data-nav-toggle><span></span><span></span><span></span></button>
      <nav id="nav" aria-label="Main">
        {hubs.slice(0, 5).map((h) => <a href={url(h)}>{clusters[h.cluster].label}</a>)}
        <a class="btn sm" href={quoteLink('website design Nairobi')}>Get a quote</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap foot">
        <div>
          <p class="logo"><span>webdesign<b>nairobi</b>.co.ke</span></p>
          <p>Website design and development for businesses in Nairobi and across Kenya.</p>
          {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
          {site.phone && <p><a href={`tel:${site.phone}`}>{site.phone}</a></p>}
          <p><a href="/contact/">Contact</a></p>
        </div>
        {hubs.map((h) => (
          <div>
            <h2>{clusters[h.cluster].label}</h2>
            <p><a href={url(h)}>{clusters[h.cluster].blurb}</a></p>
          </div>
        ))}
      </div>
    </footer>
    <div class="fab" data-fab>
      <div class="fab-menu" id="fab-menu">
        {site.whatsapp && (
          <a class="fab-opt wa" href={quoteLink('website design Nairobi')} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.4 8.4 0 01-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.4 8.4 0 013.8-.9h.5a8.5 8.5 0 018 8z" /></svg>WhatsApp us
          </a>
        )}
        {site.phone && (
          <a class="fab-opt" href={`tel:${site.phone}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z" /></svg>Call us
          </a>
        )}
      </div>
      <button class="fab-btn" type="button" aria-label="Contact us" aria-expanded="false" aria-controls="fab-menu" data-fab-toggle>
        <span class="ring"></span><span class="ring r2"></span>
        <svg class="i-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.4 8.4 0 01-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.4 8.4 0 013.8-.9h.5a8.5 8.5 0 018 8z" /></svg>
        <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <script>
      const root = document.documentElement;
      const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- scroll reveal (cards stagger in) ---- */
      const reveal = () => {
        if (!('IntersectionObserver' in window) || still()) return;
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
        document.querySelectorAll<HTMLElement>('.tier, .group, .bento li, .timeline li, details, .final').forEach((el) => {
          const sib = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0;
          el.style.setProperty('--rd', `${Math.min(sib, 5) * 0.07}s`);
          el.classList.add('reveal');
          io.observe(el);
        });
      };

      /* ---- parallax engine ----
         [data-par]   in-page shapes: drift against scroll, relative to their parent's position
         [data-fix]   fixed background blobs: drift with total scroll
         [data-depth] hero illustration layers: follow the pointer for depth */
      type Item = { el: HTMLElement; s: number; host: Element | null };
      let par: Item[] = [], fix: Item[] = [], depth: { el: SVGElement; k: number }[] = [];
      let queued = false, raf = 0, tx = 0, ty = 0, cx = 0, cy = 0;
      const collect = () => {
        par = [...document.querySelectorAll<HTMLElement>('[data-par]')].map((el) => ({ el, s: parseFloat(el.dataset.par || '0'), host: el.parentElement }));
        fix = [...document.querySelectorAll<HTMLElement>('[data-fix]')].map((el) => ({ el, s: parseFloat(el.dataset.fix || '0'), host: null }));
        depth = [...document.querySelectorAll<SVGElement>('[data-depth]')].map((el) => ({ el, k: parseFloat(el.getAttribute('data-depth') || '0') }));
      };
      const paint = () => {
        queued = false;
        const y = scrollY, vh = innerHeight, max = root.scrollHeight - vh;
        root.style.setProperty('--p', (max > 0 ? Math.min(1, y / max) : 0).toFixed(4));
        if (still()) return;
        for (const { el, s, host } of par) {
          const r = host!.getBoundingClientRect();
          if (r.bottom < -300 || r.top > vh + 300) continue;
          el.style.transform = `translate3d(0, ${(-(r.top + r.height / 2 - vh / 2) * s).toFixed(1)}px, 0)`;
        }
        for (const { el, s } of fix) el.style.transform = `translate3d(0, ${(y * s).toFixed(1)}px, 0)`;
      };
      const queue = () => { if (!queued) { queued = true; requestAnimationFrame(paint); } };
      const glide = () => {
        cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
        for (const { el, k } of depth) el.style.transform = `translate(${(cx * k).toFixed(1)}px, ${(cy * k).toFixed(1)}px)`;
        const art = document.querySelector<HTMLElement>('.hero-art');
        art?.style.setProperty('--rx', `${(-cy * 5).toFixed(2)}deg`);
        art?.style.setProperty('--ry', `${(cx * 7).toFixed(2)}deg`);
        raf = Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002 ? requestAnimationFrame(glide) : 0;
      };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      document.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return;
        const card = (e.target as Element).closest?.<HTMLElement>('.bento li, .tier, .group, details');
        if (card) {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        }
        const hero = document.querySelector('.hero');
        if (!hero || still() || !depth.length) return;
        const r = hero.getBoundingClientRect();
        if (r.bottom < 0) return;
        tx = Math.max(-1, Math.min(1, (e.clientX / innerWidth - 0.5) * 2));
        ty = Math.max(-1, Math.min(1, ((e.clientY - r.top) / Math.max(r.height, 1) - 0.5) * 2));
        if (!raf) raf = requestAnimationFrame(glide);
      });
      document.addEventListener('astro:page-load', () => {
        reveal(); collect(); paint();
        if (still()) document.querySelectorAll('svg').forEach((v) => v.pauseAnimations?.());
      });
      // Menus use one delegated listener, so they keep working after page transitions replace the DOM.
      const closeAll = (except?: Element | null) => {
        document.querySelectorAll('[data-top].open, [data-fab].open').forEach((el) => {
          if (el !== except) { el.classList.remove('open'); el.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false'); }
        });
      };
      document.addEventListener('click', (e) => {
        const t = e.target as Element;
        const btn = t.closest('[data-nav-toggle], [data-fab-toggle]');
        const host = btn?.closest('[data-top], [data-fab]') ?? null;
        closeAll(host);
        if (btn && host) {
          const open = host.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(open));
          if (btn.hasAttribute('data-nav-toggle')) btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        }
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
    </script>
  </body>
</html>
